      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pfd:slo_availability:error_budget_remaining{namespace=\"$namespace\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
