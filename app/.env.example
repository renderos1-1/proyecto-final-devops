DATABASE_URL=postgres://app_user:replace_with_database_password@localhost:5432/events
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace_with_database_password
POSTGRES_DB=events
INGEST_API_KEYS=replace_with_ingestion_key
ADMIN_API_KEY=replace_with_admin_key
APP_ENV=dev
LOG_LEVEL=info
GIT_SHA=unknown
APP_VERSION=0.0.0
MAX_FUTURE_SKEW_SECONDS=300
PROCESSOR_BATCH_SIZE=100
PROCESSOR_POLL_INTERVAL_MS=500
PROCESSOR_LEASE_SECONDS=60
PROCESSOR_ARTIFICIAL_DELAY_MS=0
# PORT defaults to 3000 for ingest-api, 3001 for processor.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME defaults to the application name.
