{
  "name": "event-platform",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "lint": "eslint . && tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "npm run build && tsx --test --test-concurrency=1 test/*.e2e.ts",
    "migrate": "npm run build && node dist/migrate.js",
    "start:ingest-api": "node dist/apps/ingest-api/main.js",
    "start:processor": "node dist/apps/processor/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.1",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "dotenv": "^17.2.0",
    "express": "^5.3.0",
    "pg": "^8.16.0",
    "pino": "^10.1.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
