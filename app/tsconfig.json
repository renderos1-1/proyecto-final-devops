{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node",
    "lib": ["ES2022"], "strict": true, "noUncheckedIndexedAccess": true,
    "esModuleInterop": true, "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "skipLibCheck": true, "rootDir": ".", "outDir": "dist", "sourceMap": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["apps/**/*.ts", "libs/**/*.ts", "migrate.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
